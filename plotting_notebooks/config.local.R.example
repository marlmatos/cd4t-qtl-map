# config.local.R.example
#
# Copy this file to `config.local.R` (same directory) and fill in your own
# absolute paths. `config.local.R` is intentionally gitignored (see
# .gitignore: `*/config.local.R`) because it points at cluster-specific data
# locations — it should never be committed. Each `plotting_notebook_figure_*.Rmd`
# starts with `source("config.local.R")` and expects the objects below to exist.
#
# All entries are file/directory path strings unless noted otherwise.

# R library path used by .libPaths() at the top of every notebook.
r_lib_path_44 <- "~/R/x86_64-pc-linux-gnu-library/4.4"

