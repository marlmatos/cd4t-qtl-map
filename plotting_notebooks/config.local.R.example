  color_pallete_helper         = "analysis/utils/color_pallete_helper.R",
  summary_df                   = "/path/to/eqtl_caqtl_finemapping_coloc_all.tsv",
  summary_path                 = "/path/to/figure1/data",
  caqtl_credible_sets_template = "/path/to/caqtl_credible_sets_chr{chr}.tsv",
  eqtl_credible_sets_template  = "/path/to/eqtl_credible_sets_chr{chr}.tsv",
  caqtl_categories_pct         = "/path/to/caqtl_categories_pct.csv",
